{
  "name": "dsh-personalos-workbench",
  "version": "1.3.1",
  "description": "把待办、随手采集和随笔收进一个本地工作台：任务总清单与今日待办自动同步，粘贴一段文字就自动起标题、分类、排版，沉淀成可检索的 Markdown 知识库；数据全部留在你自己的电脑里。",
  "keywords": [
    "dsh-plugin",
    "workbench",
    "tasks",
    "notes",
    "obsidian",
    "personalos",
    "任务管理",
    "笔记"
  ],
  "license": "MIT",
  "author": "LeriusLei",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeriusLei/dsh-personalos.git"
  },
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dsh",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node --check dsh/index.js && node --check dsh/store.js && node --check lib/client.js && node scripts/check-package.mjs",
    "test": "node test/store.test.mjs && node test/client.test.mjs && node test/server.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5.0.0-0"
  }
}
